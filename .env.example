# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchup_tracking

# Secret de session nuxt-auth-utils (32 caractères minimum)
NUXT_SESSION_PASSWORD=replace_with_a_secure_random_string_of_at_least_32_chars

# Discord OAuth2 credentials
NUXT_OAUTH_DISCORD_CLIENT_ID=your_discord_client_id
NUXT_OAUTH_DISCORD_CLIENT_SECRET=your_discord_client_secret

# IP locale de la machine hôte pour le QR code et accès mobile sur le Wi-Fi
HOST_IP=192.168.1.XX
