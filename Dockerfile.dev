FROM node:22-alpine

WORKDIR /app

# Enable hot reload in Docker on macOS/Linux
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
ENV HOST=0.0.0.0
ENV PORT=3000

COPY package*.json ./

RUN npm install

COPY . .

EXPOSE 3000

CMD ["sh", "-c", "npm install && (npx tsx server/db/migrate.ts || true) && PUBLIC_FLAG=\"\" && if [ -n \"$PUBLIC_URL\" ]; then PUBLIC_FLAG=\"--publicURL $PUBLIC_URL\"; elif [ -n \"$HOST_IP\" ]; then PUBLIC_FLAG=\"--publicURL http://$HOST_IP:3000\"; fi && npm run dev -- --host 0.0.0.0 $PUBLIC_FLAG"]
